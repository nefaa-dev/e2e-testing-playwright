{
    "default": {
      "tags": "@active",
      "formatOptions": {
        "snippetInterface": "async-await"
      },
      "paths": [
        "src/test/features/*.feature"
      ],
      "retry": 1,
      "publishQuiet": true,
      "dryRun": false,
      "require": [
        "src/test/steps/*.ts",
        "src/hooks/hooks.ts"
      ],
      "requireModule": [
        "ts-node/register"
      ],
      "format": [
        "progress-bar",
        "html:test-results/cucumber-report.html",
        "json:test-results/cucumber-report.json",
        "junit:test-results/cucumber-report.xml:alwaysGenerateReport= true"
      ],
      "parallel": 3
  
    }
  }
  